[
  {
    "id": "A-basic",
    "note": "3 students; CLO1=q1, CLO2=final, CLO3=q1+final. Hand-computed (exact fractions, rounded once at the end).",
    "threshold": 60,
    "max_marks": { "q1": 10, "final": 50 },
    "clo_map": { "CLO1": { "q1": 1 }, "CLO2": { "final": 1 }, "CLO3": { "q1": 1, "final": 1 } },
    "cos": { "CO1": { "CLO1": 1, "CLO2": 1 }, "CO2": { "CLO2": 2, "CLO3": 1 } },
    "pos": { "PO1": { "CO1": 1, "CO2": 1 } },
    "students": [ { "q1": 10, "final": 50 }, { "q1": 5, "final": 25 }, { "q1": 8, "final": 20 } ],
    "expected": {
      "clo": { "CLO1": { "avg": 76.7, "below_count": 1, "below_threshold": false },
               "CLO2": { "avg": 63.3, "below_count": 2, "below_threshold": true },
               "CLO3": { "avg": 65.6, "below_count": 2, "below_threshold": true } },
      "co": { "CO1": { "avg": 70.0, "below_threshold": false }, "CO2": { "avg": 64.1, "below_threshold": false } },
      "po": { "PO1": { "avg": 67.0 } }
    }
  },
  {
    "id": "B-ungraded-student-ignored",
    "note": "Same as A plus an enrolled student with no marks row: results must not change.",
    "threshold": 60,
    "max_marks": { "q1": 10, "final": 50 },
    "clo_map": { "CLO1": { "q1": 1 }, "CLO2": { "final": 1 }, "CLO3": { "q1": 1, "final": 1 } },
    "cos": { "CO1": { "CLO1": 1, "CLO2": 1 }, "CO2": { "CLO2": 2, "CLO3": 1 } },
    "pos": { "PO1": { "CO1": 1, "CO2": 1 } },
    "students": [ { "q1": 10, "final": 50 }, { "q1": 5, "final": 25 }, { "q1": 8, "final": 20 }, { "ungraded": true } ],
    "expected": {
      "clo": { "CLO1": { "avg": 76.7, "below_count": 1, "below_threshold": false },
               "CLO2": { "avg": 63.3, "below_count": 2, "below_threshold": true },
               "CLO3": { "avg": 65.6, "below_count": 2, "below_threshold": true } },
      "co": { "CO1": { "avg": 70.0, "below_threshold": false }, "CO2": { "avg": 64.1, "below_threshold": false } },
      "po": { "PO1": { "avg": 67.0 } }
    }
  },
  {
