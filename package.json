{
  "name": "facultymind",
  "version": "1.0.0",
  "description": "AI-powered academic management platform for university faculty",
  "main": "src/main/main.js",
  "author": "Shad <shad@daffodilvarsity.edu.bd>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "test": "node tests/run.js",
    "bench": "node bench/run.js",
    "eval": "node eval/run.js"
  },
  "keywords": [],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.9.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.0",
    "fuse.js": "^7.1.0",
    "googleapis": "^171.4.0",
    "keytar": "^7.9.0",
    "mammoth": "^1.12.0",
    "onnxruntime-node": "^1.26.0",
    "openai": "^4.99.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "32.3.3",
    "electron-builder": "^25.1.8",
    "pdfkit": "^0.18.0"
  },
  "build": {
    "appId": "com.shad.facultymind",
    "productName": "FacultyMind",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node",
      "node_modules/keytar/build/Release/*.node",
      "node_modules/onnxruntime-node/bin/**",
      "node_modules/onnxruntime-node/lib/binding/**",
      "node_modules/@xenova/transformers/dist/*.wasm",
      "node_modules/@xenova/transformers/dist/*.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/keytar/build/**",
      "!node_modules/onnxruntime-node/bin/**",
      "!node_modules/onnxruntime-node/lib/binding/**"
    ]
  }
}
